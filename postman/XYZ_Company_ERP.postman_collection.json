{
  "info": {
    "name": "XYZ Company ERP + CRM API",
    "description": "Complete API collection for XYZ Company ERP + CRM Operations Portal.\n\nSetup:\n1. Create an environment with variables: base_url, token\n2. Set base_url to http://localhost:3000 (or your deployed URL)\n3. Login first, then copy the token from response to the token variable\n4. All authenticated requests use Bearer {{token}} in Authorization header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
